+/* Capacity reported by APFS at Data mount, before userspace starts. Never synthesize free space. */
+volatile int aston_data_capacity_status = -1;
+uint64_t aston_data_capacity_bytes, aston_data_free_bytes, aston_data_available_bytes;
+static void
+aston_data_capacity_checkpoint(mount_t mp)
+{
+	struct vfs_attr va = {0};
+	VFSATTR_INIT(&va);
+	VFSATTR_WANTED(&va, f_bsize);
+	VFSATTR_WANTED(&va, f_blocks);
+	VFSATTR_WANTED(&va, f_bfree);
+	VFSATTR_WANTED(&va, f_bavail);
+	int error = vfs_getattr(mp, &va, vfs_context_current());
+	if (!error && !VFSATTR_ALL_SUPPORTED(&va)) error = ENOTSUP;
+	if (!error && (!va.f_bsize || !va.f_blocks || va.f_blocks > UINT64_MAX / va.f_bsize ||
+	    va.f_bfree > va.f_blocks || va.f_bavail > va.f_bfree)) error = EINVAL;
+	if (!error) {
+		aston_data_capacity_bytes = va.f_blocks * va.f_bsize;
+		aston_data_free_bytes = va.f_bfree * va.f_bsize;
+		aston_data_available_bytes = va.f_bavail * va.f_bsize;
+	}
+	aston_data_capacity_status = error;
+	printf("aston-data: capacity status=%d total=%llu free=%llu available=%llu\n", error,
+	    (unsigned long long)aston_data_capacity_bytes, (unsigned long long)aston_data_free_bytes,
+	    (unsigned long long)aston_data_available_bytes);
+}
