+// ---- Deep idle through PSCI CPU_SUSPEND (armcpu-idle) ----
+// XNU calls the processor_idle hook (cpu_data cpu_idle_notify) with interrupts masked right before its WFI, and again from
+// cpu_idle_exit. A core that CPU_SUSPEND powers down comes back at the entry point given here, the kernel's reset vector, whose
+// handler for a core that has booted is resume_idle_cpu: arm_init_idle_cpu restores the EL1 state, re-enables the virtual timer and
+// returns through cpu_idle_exit(TRUE), which calls the hook again (enter FALSE). There the GIC CPU interface and the timer's compare
+// value, both lost with the core, are restored. Wake-up events are interrupts, masked or not: the virtual timer, set armcpu-idle-early-us
+// ahead of the kernel's deadline to cover the exit latency, and IPIs.
+// armcpu-idle: 0 off; 1 PSCI_VERSION and PSCI_FEATURES(CPU_SUSPEND) read at boot, nothing suspended; 2 cores other than the boot core
+// request armcpu-idle-state when the timer is at least armcpu-idle-min-us away; 3 every core, and armcpu-idle-cluster-state when the
+// timer is at least armcpu-idle-cluster-us away (platform-coordinated mode: the firmware takes the cluster down once all its cores ask).
+// The states default to the SM8550 devicetree's CPU "rail-pc" (0x40000004) and cluster "l3-off" (0x41000044), extended StateID format.
+// A core that wakes more than 50 ms after its timer three times (the hypervisor does not wake a suspended core for it) or a refused
+// CPU state turns deep idle off again.
+static void idleProbe (void)
+{
+  PE_parse_boot_argn ("armcpu-idle", &gIdleMode, sizeof (gIdleMode));
+  PE_parse_boot_argn ("armcpu-idle-state", &gIdleState, sizeof (gIdleState));
+  PE_parse_boot_argn ("armcpu-idle-cluster-state", &gIdleClusterState, sizeof (gIdleClusterState));
+  uint32_t minUs = 10000, clusterUs = 20000, earlyUs = 2000;
+  PE_parse_boot_argn ("armcpu-idle-min-us", &minUs, sizeof (minUs));
+  PE_parse_boot_argn ("armcpu-idle-cluster-us", &clusterUs, sizeof (clusterUs));
+  PE_parse_boot_argn ("armcpu-idle-early-us", &earlyUs, sizeof (earlyUs));
+  armcpu_idle_info[2] = -1;
+  if (gIdleMode == 0) { armcpu_idle_info[0] = 0; return; }
+  bool hvc = false;
+  if (!psciConduit (&hvc)) { gIdleMode = 0; armcpu_idle_info[3] = 3; armcpu_idle_info[0] = 0; return; }
+  gIdleHvc = hvc;
+  const int64_t version = psciCall (hvc, 0x84000000ULL, 0, 0, 0);
+  armcpu_idle_info[1] = static_cast<int32_t> (version);
+  if (version >= 0x10000) { armcpu_idle_info[2] = static_cast<int32_t> (psciCall (hvc, 0x8400000aULL, 0xc4000001ULL, 0, 0)); }
+  // CPU_SUSPEND is mandatory from PSCI 0.2; a negative PSCI_FEATURES answer means it is not offered to this OS.
+  if (version < 0x2 || armcpu_idle_info[2] < -1) { gIdleMode = 1; }
+  __asm__ volatile ("mrs %0, cntfrq_el0" : "=r" (gIdleFreq));
+  gIdleMinTicks = gIdleFreq * minUs / 1000000;
+  gIdleClusterTicks = gIdleFreq * clusterUs / 1000000;
+  gIdleEarlyTicks = gIdleFreq * earlyUs / 1000000;
+  gIdleLateTicks = gIdleFreq / 20;
+  if (gIdleEarlyTicks >= gIdleMinTicks) { gIdleEarlyTicks = gIdleMinTicks / 2; }
+  gIdleEntry = static_cast<uint64_t> (ml_static_vtop (reinterpret_cast<vm_offset_t> (LowResetVectorBase)));
+  armcpu_idle_info[0] = static_cast<int32_t> (gIdleMode);
+}
+
+// The GIC CPU interface as enableGic leaves it: system register access, EOImode 0, all priorities unmasked, group 1 on.
+static void idleGicRestore (void)
+{
+  uint64_t value;
+  __asm__ volatile ("mrs %0, icc_sre_el1" : "=r" (value));
+  value |= 1;
+  __asm__ volatile ("msr icc_sre_el1, %0; isb" :: "r" (value) : "memory");
+  __asm__ volatile ("mrs %0, icc_ctlr_el1" : "=r" (value));
+  value &= ~2ULL;
+  __asm__ volatile ("msr icc_ctlr_el1, %0" :: "r" (value) : "memory");
+  value = 0xff;
+  __asm__ volatile ("msr icc_pmr_el1, %0" :: "r" (value) : "memory");
+  value = 0;
+  __asm__ volatile ("msr icc_bpr1_el1, %0" :: "r" (value) : "memory");
+  value = 1;
+  __asm__ volatile ("msr icc_igrpen1_el1, %0; dsb sy; isb" :: "r" (value) : "memory");
+}
+
+static void idleStop (int32_t why)
+{
+  __atomic_store_n (&gIdleMode, 1U, __ATOMIC_RELAXED);
+  armcpu_idle_info[0] = 1;
+  armcpu_idle_info[3] = why;
+}
+
+void ArmCpu::idleHook (cpu_id_t cpu, boolean_t enter, uint64_t *)
+{
+  ArmCpu *self = static_cast<ArmCpu *> (cpu);
+  const uint32_t id = self->logicalId;
+  if (id >= ARMCPU_SMP_SLOTS) { return; }
+  IdleSave &save = gIdleSave[id];
+  volatile int32_t *s = armcpu_idle_stats[id];
+  if (!enter) {
+    if (__atomic_load_n (&save.down, __ATOMIC_ACQUIRE) == 0) { return; }
+    // Back through the reset vector.
+    idleGicRestore ();
+    __asm__ volatile ("msr cntv_cval_el0, %0" :: "r" (save.cval) : "memory");
+    __asm__ volatile ("msr cntv_ctl_el0, %0; isb" :: "r" (save.ctl & 1) : "memory");
+    const uint64_t now = counter ();
+    s[1] = s[1] + 1;
+    s[7] = s[7] + static_cast<int32_t> ((now - save.entered) * 1000 / gIdleFreq);
+    if (now > save.cval) {
+      const uint64_t late = now - save.cval;
+      s[5] = static_cast<int32_t> (late * 1000000 / gIdleFreq);
+      if (late > gIdleLateTicks && __atomic_add_fetch (&gIdleLate, 1U, __ATOMIC_RELAXED) >= 3) { idleStop (1); }
+    }
+    __atomic_store_n (&save.down, 0U, __ATOMIC_RELEASE);
+    return;
+  }
+  const uint32_t mode = __atomic_load_n (&gIdleMode, __ATOMIC_RELAXED);
+  if (mode < 2 || (mode == 2 && !self->secondary)) { return; }
+  uint64_t ctl, cval;
+  __asm__ volatile ("mrs %0, cntv_ctl_el0" : "=r" (ctl));
+  __asm__ volatile ("mrs %0, cntv_cval_el0" : "=r" (cval));
+  const uint64_t now = counter ();
+  // Only with a known wake-up: the kernel's timer armed, unmasked and far enough away.
+  if ((ctl & 3) != 1 || cval <= now || cval - now < gIdleMinTicks) { return; }
+  const bool cluster = mode >= 3 && gIdleClusterOk && cval - now >= gIdleClusterTicks;
+  save.cval = cval;
+  save.ctl = ctl;
+  save.entered = now;
+  __atomic_store_n (&save.down, 1U, __ATOMIC_RELEASE);
+  s[0] = s[0] + 1;
+  if (cluster) { s[6] = s[6] + 1; }
+  __asm__ volatile ("msr cntv_cval_el0, %0; isb" :: "r" (cval - gIdleEarlyTicks) : "memory");
+  const int64_t result = psciCall (gIdleHvc, 0xc4000001ULL, cluster ? gIdleClusterState : gIdleState, gIdleEntry, id);
+  // Only a core that kept its state gets here: a pending interrupt, a shallower state chosen by the firmware, or a refusal.
+  __asm__ volatile ("msr cntv_cval_el0, %0; isb" :: "r" (cval) : "memory");
+  __atomic_store_n (&save.down, 0U, __ATOMIC_RELEASE);
+  s[4] = static_cast<int32_t> (result);
+  if (result == 0) {
+    s[2] = s[2] + 1;
+  } else {
+    s[3] = s[3] + 1;
+    // PSCI INVALID_PARAMETERS (-2) or DENIED (-3) for a state: never ask for it again.
+    if (result == -2 || result == -3) {
+      if (cluster) { gIdleClusterOk = false; } else { idleStop (2); }
+    }
+  }
+}
