+// Deep idle state (armcpu-idle); the hook and its boot probe are with the PSCI calls below.
+static uint32_t gIdleMode = 1, gIdleState = 0x40000004, gIdleClusterState = 0x41000044;
+static bool gIdleHvc = false, gIdleClusterOk = true;
+static uint64_t gIdleEntry = 0, gIdleFreq = 0, gIdleMinTicks = 0, gIdleClusterTicks = 0, gIdleEarlyTicks = 0, gIdleLateTicks = 0;
+static uint32_t gIdleLate = 0;
+// Per core, written before a power-down request and cleared when the core is back in the hook.
+struct IdleSave { uint64_t cval, ctl, entered; uint32_t down; };
+static IdleSave gIdleSave[ARMCPU_SMP_SLOTS];
+
+extern "C" {
+// [0] mode in effect, [1] PSCI_VERSION, [2] PSCI_FEATURES(CPU_SUSPEND) (-1 not asked), [3] why deep idle stopped (1 late wake-ups,
+// 2 CPU state refused, 3 no PSCI conduit)
+volatile int32_t armcpu_idle_info[4];
+// Per logical core: [0] requests, [1] returns through the reset vector, [2] returns from the call, [3] refused requests, [4] last
+// result, [5] latest wake after the kernel's deadline (us), [6] cluster requests, [7] milliseconds spent powered down
+volatile int32_t armcpu_idle_stats[ARMCPU_SMP_SLOTS][8];
+}
