+[root]
+# The decrypted iPhone17,2 images (OS = 043-69909-664.dmg.aea, Cryptex1,SystemOS = 043-68526-711.dmg.aea): raw APFS
+# containers without a partition map, so the .dmg sha256 is the raw disk digest the root policies sign.
