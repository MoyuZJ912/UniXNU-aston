+    // iOS 27.0.1 24A446 (iPhone17,2) 1892D244-891C-3C95-A09A-2810410FDCF8
+    {{0x18, 0x92, 0xd2, 0x44, 0x89, 0x1c, 0x3c, 0x95, 0xa0, 0x9a, 0x28, 0x10, 0x41, 0x0f, 0xdc, 0xf8},
+     0x1846dce88, 0x184461928, 0x1e7024fc0, 0x1e702516c, 0x1e701fdd9, 0x1e9025680},
+};
+// The running cache's entry and its slide, or null: then nothing is read or written by address. A candidate's slide comes from
+// CARenderServerStart; the cache header at the slid 0x180000000 must then carry dyld's magic and that entry's UUID.
+static const QuartzCoreSites *quartzCoreSites(uintptr_t *slide) {
+    void *start = dlsym(RTLD_DEFAULT, "CARenderServerStart");
+    if (!start) return nullptr;
+    const uintptr_t at = (uintptr_t)ptrauth_strip(start, ptrauth_key_function_pointer);
+    for (const QuartzCoreSites &sites : kQuartzCoreSites) {
+        const uintptr_t candidate = at - sites.renderServerStart;
+        uint8_t header[0x68] = {};
+        if (!readTask(0x180000000 + candidate, header, sizeof header)) continue;
+        if (memcmp(header, "dyld_v1  arm64e", 16) || memcmp(header + 0x58, sites.uuid, sizeof sites.uuid)) continue;
+        *slide = candidate;
+        return &sites;
+    }
+    return nullptr;
+}
