+// address is used only in the cache whose UUID it was found in (after UniXNU-asteroids 5650eda, which keys its plugin the same way).
+// The iPhone17,2 cache's QuartzCore has the iPad's segment sizes and code addresses, and its __DATA_DIRTY, __AUTH and __AUTH_CONST
+// 0x4000 higher: every ADRP reference of QuartzCore's __text into those segments (7978 and 6450 of them) reaches 0x4000 higher at the
+// same instruction, among them each address below (UniXNU-aston, read from the two IPSWs' SystemOS images).
+struct QuartzCoreSites {
+    uint8_t uuid[16];
+    uintptr_t renderServerStart;   // _CARenderServerStart, for the slide
+    uintptr_t framebufferBranch;   // the `tbnz w8, #0` of IOMFBDisplay::framebuffer_pixel_format on the virtualized byte
+    uintptr_t debugValues;         // the float debug options; index 21 the EDR headroom override, 81 the FP16 threshold
+    uintptr_t debugOptions;        // _ca_debug_options; +128 CA_FORCE_FP16_FRAMEBUFFER, +156 CA_ALLOW_EDR_MIRRORING
+    uintptr_t virtualized;         // the device-is-virtualized byte
+    uintptr_t virtualizedKey;      // the constant CFString naming it
+};
